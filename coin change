#include <iostream>
#include <vector>
#include <algorithm>
using namespace std;

int main() {
    int n, amount;

    cout << "Enter number of coins: ";
    cin >> n;

    vector<int> coin(n);

    cout << "Enter coin denominations: ";
    for (int i = 0; i < n; i++) {
        cin >> coin[i];
    }

    cout << "Enter amount: ";
    cin >> amount;

    // dp[i] = minimum coins required to make amount i
    vector<int> dp(amount + 1, amount + 1);

    dp[0] = 0;

    // Dynamic Programming
    for (int i = 1; i <= amount; i++) {
        for (int j = 0; j < n; j++) {
            if (coin[j] <= i) {
                dp[i] = min(dp[i], dp[i - coin[j]] + 1);
            }
        }
    }

    if (dp[amount] > amount) {
        cout << "Change cannot be made." << endl;
    } else {
        cout << "Minimum number of coins = " << dp[amount] << endl;
    }

    return 0;
}

input:
Enter number of coins: 3
Enter coin denominations: 1 2 5
Enter amount: 11

output:
Minimum number of coins = 3
